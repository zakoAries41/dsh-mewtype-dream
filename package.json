{
    "name":  "@local/dsh-mewtype-dream",
    "version":  "1.6.1",
    "private":  true,
    "type":  "module",
    "description":  "MewType dream appearance for the DeepSeek Harness Web GUI: five character palettes, aurora and starlight with a density control, character placeholder, personality openers, and an optional portrait you embed from your own artwork.",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "docs",
                  "icon.svg",
                  "scripts",
                  "LICENSE",
                  "NOTICE.md",
                  "README.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-conversation"
                                          ]
                           }
            },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/zakoAries41/dsh-mewtype-dream.git"
                   },
    "license":  "MIT",
    "scripts":  {
                    "embed-art":  "node scripts/embed-art.mjs"
                }
}
